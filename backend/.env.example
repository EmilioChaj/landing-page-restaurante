# API key de Brevo (Settings -> API Keys)
BREVO_API_KEY=

# ID de la lista de contactos en Brevo
BREVO_LIST_ID=

# ID del template de Double Opt-In en Brevo
BREVO_TEMPLATE_ID=

# URL del frontend (Vercel) para CORS
CORS_ORIGIN=http://localhost:5173

# URL de este backend para redirección post-confirmación
REDIRECT_URL=http://localhost:3001

# Puerto del servidor (Render lo asigna automaticamente)
PORT=3001

# Entorno
NODE_ENV=development
